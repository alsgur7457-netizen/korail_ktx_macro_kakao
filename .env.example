# ── 코레일 계정 ─────────────────────────────────────────────
# 휴대폰번호(010-xxxx-xxxx), 이메일 또는 회원번호
KORAIL_ID=010-1234-5678
KORAIL_PW=your_korail_password

# ── 예매 조건 (make run 용. 웹페이지를 쓰면 웹에서 입력하므로 비워둬도 됨) ─────────
# 출발 날짜 YYYYMMDD
TRAIN_DATE=20261101
# 출발역 ('역' 제외)
TRAIN_FROM=서울
# 도착역
TRAIN_TO=부산
# 이 시각 이후 출발 (HHMM)
TRAIN_TIME=0800
# 이 시각 전에 출발하는 열차만 (HHMM, 2400 = 제한 없음)
TRAIN_UNTIL=1200
# KTX | ALL
TRAIN_TYPE=KTX
# GENERAL_FIRST | GENERAL_ONLY | SPECIAL_FIRST | SPECIAL_ONLY
TRAIN_SEAT=GENERAL_FIRST
# 어른 인원 1~9
TRAIN_PASSENGERS=1
# consecutive(연속 좌석) | random(따로 앉기)
TRAIN_SEAT_STRATEGY=consecutive

# ── 카카오톡 '나에게 보내기' ────────────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# 보안 > Client Secret 을 '사용함'으로 설정한 경우에만
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 똑같이 등록
KAKAO_REDIRECT_URI=http://localhost:8080/kakao
# 토큰 저장 위치 (Docker에서는 /app/data/kakao_token.json 고정)
# KAKAO_TOKEN_FILE=~/.korail_bot_kakao.json

# ── 웹페이지 (make web) ────────────────────────────────────
# 휴대폰에서 웹페이지에 들어갈 때 쓰는 PIN (4자리 이상, 남이 짐작하기 어렵게)
WEB_PIN=
# 웹페이지 포트 (http://PC주소:8000)
WEB_PORT=8000

# ── 동작 설정 ───────────────────────────────────────────────
# 조회 간격(초). 3초보다 짧게 하면 매크로로 판정돼 IP가 차단됩니다.
SEARCH_INTERVAL=3
# 예약 성공 후 결제 여부 확인 간격(초)과 결제 독촉 알림 간격(분)
PAYMENT_CHECK_SECONDS=60
PAYMENT_REMINDER_MINUTES=3

# DynaPath 기기 식별자 고정 (비워두면 생성 후 KORAIL_DEVICE_FILE에 저장)
# KORAIL_DEVICE_PROFILE_ID=
# KORAIL_ANDROID_ID=
# KORAIL_DEVICE_FILE=~/.korail_bot_device.json

LOG_LEVEL=INFO
